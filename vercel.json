{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "routes": [
        {
            "src": "/(.*)",
            "has": [
                {
                    "type": "header",
                    "key": "user-agent",
                    "value": {
                        "re": "(?i)(Amazonbot|anthropic-ai|Applebot-Extended|Bytespider|CCBot|ChatGPT-User|ClaudeBot|Claude-SearchBot|Claude-User|cohere-ai|Diffbot|DuckAssistBot|FacebookBot|Google-Extended|GPTBot|ImagesiftBot|meta-externalagent|meta-externalfetcher|OAI-SearchBot|omgili|PanguBot|PerplexityBot|Perplexity-User|PetalBot|Timpibot|YouBot)"
                    }
                }
            ],
            "mitigate": {
                "action": "deny"
            }
        }
    ],
    "headers": [
        {
            "source": "/(.*)",
            "headers": [
                {
                    "key": "Content-Signal",
                    "value": "search=yes, ai-input=no, ai-train=no"
                },
                {
                    "key": "X-Robots-Tag",
                    "value": "noimageindex, noai, noimageai"
                }
            ]
        },
        {
            "source": "/photography/:path*",
            "headers": [
                {
                    "key": "X-Robots-Tag",
                    "value": "noindex, nofollow, noarchive, nosnippet, noimageindex, noai, noimageai"
                }
            ]
        },
        {
            "source": "/images/:path*",
            "headers": [
                {
                    "key": "X-Robots-Tag",
                    "value": "noindex, nofollow, noarchive, nosnippet, noimageindex, noai, noimageai"
                }
            ]
        },
        {
            "source": "/_vercel/image",
            "headers": [
                {
                    "key": "X-Robots-Tag",
                    "value": "noindex, nofollow, noarchive, nosnippet, noimageindex, noai, noimageai"
                }
            ]
        }
    ]
}
